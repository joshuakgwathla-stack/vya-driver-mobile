{
  "expo": {
    "name": "Vya Umshayeli",
    "slug": "vya-driver-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "vyadriver",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1f4a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vya.driver",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Vya needs your location in the background so passengers can track your live position during active trips.",
        "NSLocationAlwaysUsageDescription": "Vya needs your location in the background so passengers can track your live position during active trips.",
        "NSLocationWhenInUseUsageDescription": "Vya needs your location to share your live position with passengers during active trips."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1f4a"
      },
      "package": "com.vya.driver",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0a0f1e"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Vya needs your location at all times during active trips so passengers can see your live position on the map.",
          "locationWhenInUsePermission": "Vya needs your location to share your live position with passengers during active trips.",
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://vya-backend-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "57bcb43d-67c5-436e-bde4-760a8ec8a340"
      }
    },
    "owner": "joshuakgwathla",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/57bcb43d-67c5-436e-bde4-760a8ec8a340"
    }
  }
}
